# SolaxManager environment template
# Copy this file to .env and adjust values for the local installation.
# Never commit real passwords or other credentials.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Database created by the datastore container.
POSTGRES_DB=solaxmanager

# PostgreSQL application user used by all SolaxManager services.
POSTGRES_USER=solax

# Password for POSTGRES_USER. Use a local secret in .env.
POSTGRES_PASSWORD=change_me

# Development-only host port used to expose PostgreSQL from Docker.
# Production keeps PostgreSQL on the internal Docker network.
POSTGRES_DEV_PORT=5432


# ---------------------------------------------------------------------------
# SolaX inverter
# ---------------------------------------------------------------------------

# Base URL / IP address of the inverter local HTTP API.
SOLAX_URL=http://192.168.1.20

# Password required by the SolaX local HTTP API.
SOLAX_PASSWORD=

# Base wait between reader loop iterations, shared by both reader containers.
# Individual HTTP reads below run every N-th loop iteration.
READER_BASE_INTERVAL_SECONDS=5

# SolaX realtime telemetry (ReadRealTimeData): 1 = every loop.
SOLAX_REALTIME_EVERY_N_LOOPS=1

# SolaX tracked configuration (ReadSetData): with a 5 s base, 12 = about 60 s.
SOLAX_CONFIG_EVERY_N_LOOPS=12


# ---------------------------------------------------------------------------
# AZ Router
# ---------------------------------------------------------------------------

# Base URL / IP address of AZ Router.
# azrouter_reader reads local /api/v1/power and /api/v1/devices endpoints.
# No login is required for these read-only endpoints on the current installation.
AZROUTER_URL=http://192.168.1.21

# AZ Router /api/v1/power: 1 = every reader loop.
AZROUTER_POWER_EVERY_N_LOOPS=1

# AZ Router /api/v1/devices operational state.
# With a 5 s base loop and value 3, device/boiler state is sampled about every 15 s.
AZROUTER_DEVICES_EVERY_N_LOOPS=3

# AZ Router tracked configuration.
# Reads /api/v1/settings and reuses /api/v1/devices; 12 = about 60 s.
AZROUTER_CONFIG_EVERY_N_LOOPS=12


# ---------------------------------------------------------------------------
# Reporter / retention
# ---------------------------------------------------------------------------

# How often the reporter wakes up to calculate aggregates / housekeeping.
REPORT_INTERVAL_SECONDS=60

# Number of days to keep high-frequency raw telemetry.
RAW_RETENTION_DAYS=30


# ---------------------------------------------------------------------------
# Telemetry API / UI
# ---------------------------------------------------------------------------

# A latest sample older than this many seconds is marked stale.
TELEMETRY_STALE_AFTER_SECONDS=15

# Host TCP port that serves the web dashboard.
UI_PORT=8088


# ---------------------------------------------------------------------------
# Controller
# ---------------------------------------------------------------------------

# Safety mode for controller writes. Keep dry-run until write paths are tested.
CONTROLLER_MODE=dry-run
