# SolaxManager environment template
# Copy this file to .env and adjust values for the local installation.
# Never commit real passwords or other credentials.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Database created by the datastore container.
POSTGRES_DB=solaxmanager

# PostgreSQL application user used by all SolaxManager services.
POSTGRES_USER=solax

# Password for POSTGRES_USER. Use a local secret in .env.
POSTGRES_PASSWORD=change_me

# ---------------------------------------------------------------------------
# SolaX inverter
# ---------------------------------------------------------------------------

# Base URL / IP address of the inverter local HTTP API.
SOLAX_URL=http://192.168.1.20

# Password required by the SolaX local HTTP API.
SOLAX_PASSWORD=

# HTTP timeout used by the controller for direct SolaX configuration calls.
SOLAX_HTTP_TIMEOUT_SECONDS=5

# Base wait between reader loop iterations, shared by both reader containers.
# Individual HTTP reads below run every N-th loop iteration.
READER_BASE_INTERVAL_SECONDS=5

# SolaX realtime telemetry (ReadRealTimeData): 1 = every loop.
SOLAX_REALTIME_EVERY_N_LOOPS=1

# SolaX tracked configuration (ReadSetData): with a 5 s base, 12 = about 60 s.
SOLAX_CONFIG_EVERY_N_LOOPS=12


# ---------------------------------------------------------------------------
# AZ Router
# ---------------------------------------------------------------------------

# Base URL / IP address of AZ Router.
# azrouter_reader reads local /api/v1/power and /api/v1/devices endpoints.
AZROUTER_URL=http://192.168.1.21

# Optional credentials used by the controller for authenticated write actions.
# Read-only endpoints may work without authentication on the local installation.
# Set both values or leave both empty.
AZROUTER_USERNAME=
AZROUTER_PASSWORD=

# HTTP timeout used by the controller for direct AZ Router API calls.
AZROUTER_HTTP_TIMEOUT_SECONDS=5

# AZ Router /api/v1/power: 1 = every reader loop.
AZROUTER_POWER_EVERY_N_LOOPS=1

# AZ Router /api/v1/devices operational state.
# With a 5 s base loop and value 3, device/boiler state is sampled about every 15 s.
AZROUTER_DEVICES_EVERY_N_LOOPS=3

# AZ Router tracked configuration.
# Reads /api/v1/settings and reuses /api/v1/devices; 12 = about 60 s.
AZROUTER_CONFIG_EVERY_N_LOOPS=12


# ---------------------------------------------------------------------------
# Solar forecast
# ---------------------------------------------------------------------------

# Exact installation coordinates. Keep the real home coordinates only in the
# local .env; do not commit them to the public repository.
SOLAR_FORECAST_LAT=
SOLAR_FORECAST_LON=

# Panel geometry used for Open-Meteo Global Tilted Irradiance (GTI).
# Tilt: 0 = horizontal, 90 = vertical.
SOLAR_PANEL_TILT_DEG=35

# Open-Meteo azimuth convention:
#   0 = south, -90 = east, +90 = west, +/-180 = north.
SOLAR_PANEL_AZIMUTH_DEG=0

# Base wait for solar_forecast_reader. Forecast providers are then polled every
# N-th loop, using the same loop-multiplier pattern as the local device readers.
SOLAR_FORECAST_BASE_INTERVAL_SECONDS=300

# Open-Meteo: 12 * 300 s = about once per hour.
OPENMETEO_EVERY_N_LOOPS=12

# Number of future hourly forecast slices requested from Open-Meteo.
OPENMETEO_FORECAST_HOURS=72


# ---------------------------------------------------------------------------
# Reporter / retention
# ---------------------------------------------------------------------------

# How often the reporter wakes up to recalculate closed 15-minute buckets.
REPORT_INTERVAL_SECONDS=60

# Maximum gap between neighbouring raw samples that may be interpolated.
# Longer gaps are left unintegrated and remain visible via max_gap metadata.
REPORTER_MAX_INTEGRATION_GAP_SECONDS=120

# Number of recent closed 15-minute periods recalculated on each run.
# On an empty energy_15m table the reporter backfills all retained raw data.
REPORTER_RECALCULATE_PERIODS=8

# Number of days to keep high-frequency raw telemetry.
RAW_RETENTION_DAYS=30


# ---------------------------------------------------------------------------
# Telemetry API / UI
# ---------------------------------------------------------------------------

# A latest sample older than this many seconds is marked stale.
TELEMETRY_STALE_AFTER_SECONDS=15

# Number of current/upcoming hourly solar forecast slices exposed to the UI.
TELEMETRY_FORECAST_HOURS=8

# ---------------------------------------------------------------------------
# Controller
# ---------------------------------------------------------------------------

# Safety mode for controller writes. This value is used by base/dev/prod Compose modes:
#   off     = reject hardware-changing actions
#   manual  = allow explicit API/user actions
#   dry-run = evaluate actions but do not write hardware
#   auto    = allow validated planner/automatic actions
CONTROLLER_MODE=dry-run

# Controller REST API listen address/port inside the Docker network.
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8090
CONTROLLER_LOG_LEVEL=info

